  m_Script: {fileID: 11500000, guid: cbfc6cd9f2e58bb4e859cef8b43f1e31, type: 3}
  m_Name: tees
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSequence
  sequenceID: tes
  dialogueNodes:
  - speakerName: Budi
    dialogueText: Halo! Mi ayam di sini katanya terkenal enak ya?
    portraitSprite: {fileID: 7394970166828568522, guid: 6f5a3a7c050196444b2ef6e0bd6ec2d0, type: 3}
    portraitSide: 0
    typingSpeed: 0.1
    audioClip: {fileID: 0}
    jumpToNodeIndex: -1
    choices:
    - choiceText: iya dong pastinya
      targetNodeIndex: 1
    - choiceText: 'biasa aja '
      targetNodeIndex: 2
  - speakerName: Budi
    dialogueText: Wah mantap! Kalau begitu, aku pesan mi ayam spesial bakso ya!
    portraitSprite: {fileID: 7394970166828568522, guid: 6f5a3a7c050196444b2ef6e0bd6ec2d0, type: 3}
    portraitSide: 0
    typingSpeed: 0.1
    audioClip: {fileID: 0}
    jumpToNodeIndex: 3
    choices: []
  - speakerName: Budi
    dialogueText: Yee, masa jualan sendiri dibilang biasa aja. Tapi ya sudah, aku
      pesan porsi standar saja.
    portraitSprite: {fileID: 7394970166828568522, guid: 6f5a3a7c050196444b2ef6e0bd6ec2d0, type: 3}
    portraitSide: 0
    typingSpeed: 0.1
    audioClip: {fileID: 0}
    jumpToNodeIndex: -1
    choices: []
  - speakerName: Budi
    dialogueText: Baiklah, aku tunggu ya mi ayamnya!
    portraitSprite: {fileID: 7394970166828568522, guid: 6f5a3a7c050196444b2ef6e0bd6ec2d0, type: 3}
    portraitSide: 0
    typingSpeed: 0.1
    audioClip: {fileID: 0}
    jumpToNodeIndex: -1
    choices: []
