  dialogueNodes:
  - speakerName: Aldi Pratama
    dialogueText: you forgot the way back home.
    portraitSprite: {fileID: 7394970166828568522, guid: 6f5a3a7c050196444b2ef6e0bd6ec2d0, type: 3}
    portraitSide: 0
    typingSpeed: 0.1
    audioClip: {fileID: 0}
    jumpToNodeIndex: -1
    choices:
    - choiceText: I worked hard back then for this family!
      moralityPointChange: -20
      targetNodeIndex: 1
    - choiceText: But I am here now, and I am just trying to keep us alive.
      moralityPointChange: 35
      targetNodeIndex: 4
  - speakerName: Aldi Pratama
    dialogueText: Oh, for the family?
    portraitSprite: {fileID: 7394970166828568522, guid: 6f5a3a7c050196444b2ef6e0bd6ec2d0, type: 3}
    portraitSide: 0
    typingSpeed: 0.1
    audioClip: {fileID: 0}
    jumpToNodeIndex: -1
    choices: []
  - speakerName: Aldi Pratama
    dialogueText: I thought it was just for yourself
    portraitSprite: {fileID: 7394970166828568522, guid: 6f5a3a7c050196444b2ef6e0bd6ec2d0, type: 3}
    portraitSide: 0
    typingSpeed: 0.1
    audioClip: {fileID: 0}
    jumpToNodeIndex: -1
    choices: []
  - speakerName: Aldi Pratama
    dialogueText: Three more days, dad. I'm going to sleep. I'm tired.
    portraitSprite: {fileID: 7394970166828568522, guid: 6f5a3a7c050196444b2ef6e0bd6ec2d0, type: 3}
    portraitSide: 0
    typingSpeed: 0.1
    audioClip: {fileID: 0}
    jumpToNodeIndex: 7
    choices: []
  - speakerName: Aldi Pratama
    dialogueText: We'll see how long you can survive out here
    portraitSprite: {fileID: 7394970166828568522, guid: 6f5a3a7c050196444b2ef6e0bd6ec2d0, type: 3}
    portraitSide: 0
    typingSpeed: 0.1
    audioClip: {fileID: 0}
    jumpToNodeIndex: -1
    choices: []
  - speakerName: Aldi Pratama
    dialogueText: Dad.... Three more days. I'm going to sleep. I'm tired.
    portraitSprite: {fileID: 7394970166828568522, guid: 6f5a3a7c050196444b2ef6e0bd6ec2d0, type: 3}
