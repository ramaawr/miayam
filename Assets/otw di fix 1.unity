  daftarDialog:
  - dialogID: mulai
    namaKarakter: Rasyid (Penjual)
    kalimatDialog: Halo! Selamat datang di Warung Mi Ayam Rasyid. Mau pesan rasa
      apa hari ini?
    nextDialogID: 
    punyaPilihan: 1
    pilihan1_Teks: Mi Ayam Bakso
    pilihan1_NextID: pilih_bakso
    pilihan2_Teks: Mi Ayam Pangsit
    pilihan2_NextID: pilih_pangsit
  - dialogID: pilih_bakso
    namaKarakter: Rasyid (Penjual)
    kalimatDialog: Wah, pilihan mantap! Mi Ayam Bakso spesial kuah hangat segera
      dibuat.
    nextDialogID: selesai_dialog
    punyaPilihan: 0
    pilihan1_Teks: Mi Ayam Bakso
    pilihan1_NextID: pilih_bakso
    pilihan2_Teks: Mi Ayam Pangsit
    pilihan2_NextID: pilih_pangsit
  - dialogID: pilih_pangsit
    namaKarakter: Rasyid (Penjual)
    kalimatDialog: Siap! Mi Ayam Pangsit dengan kerupuk renyah akan segera disajikan.
    nextDialogID: selesai_dialog
    punyaPilihan: 0
    pilihan1_Teks: Mi Ayam Bakso
    pilihan1_NextID: pilih_bakso
    pilihan2_Teks: Mi Ayam Pangsit
    pilihan2_NextID: pilih_pangsit
  - dialogID: selesai_dialog
