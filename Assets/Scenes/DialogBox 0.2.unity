  daftarDialog:
  - dialogID: mulai
    namaKarakter: Rasyid (Penjual)
    kalimatDialog: Halo! Selamat datang di Warung Mi Ayam Rasyid. Mau pesan apa hari
      ini?
    nextDialogID: 
    punyaPilihan: 1
    pilihan1_Teks: 'Mi Ayam Bakso '
    pilihan1_NextID: pilih_bakso
    pilihan1_EfekMoralitas: 25
    pilihan2_Teks: Mi Ayam Tikus
    pilihan2_NextID: pilih_tikus
    pilihan2_EfekMoralitas: -25
  - dialogID: pilih_bakso
    namaKarakter: Rasyid (Penjual)
    kalimatDialog: Wah, pilihan mantap! Mi Ayam Bakso spesial kuah hangat segera
      dibuat.
    nextDialogID: lanjut_bakso
    punyaPilihan: 0
    pilihan1_Teks: Mi Ayam Bakso
    pilihan1_NextID: pilih_bakso
    pilihan1_EfekMoralitas: 0
    pilihan2_Teks: Mi Ayam Pangsit
    pilihan2_NextID: pilih_pangsit
    pilihan2_EfekMoralitas: 0
  - dialogID: pilih_tikus
    namaKarakter: Rasyid (Penjual)
    kalimatDialog: Saya Tidak Menjual Daging tikus disini.. maksud kamu apa?
    nextDialogID: selesai_dialog_jahat
    punyaPilihan: 1
    pilihan1_Teks: 'Saya hanya bercanda saja '
    pilihan1_NextID: pilih_bakso
    pilihan1_EfekMoralitas: 25
    pilihan2_Teks: Pembohong!!
    pilihan2_NextID: selesai_dialog_jahat
    pilihan2_EfekMoralitas: -25
  - dialogID: lanjut_bakso
    namaKarakter: Rasyid (Penjual)
    kalimatDialog: Mohon ditunggu sebentar ya, chef kami sedang memasak dengan cinta!
    nextDialogID: selesai_dialog_baik
    punyaPilihan: 1
    pilihan1_Teks: Baik saya tunggu ya
    pilihan1_NextID: selesai_dialog_baik
    pilihan1_EfekMoralitas: 25
    pilihan2_Teks: CEPETAN SAYA LAPAR!!
    pilihan2_NextID: selesai_dialog_jahat
    pilihan2_EfekMoralitas: -25
  - dialogID: selesai_dialog_baik
    namaKarakter: Rasyid (Penjual)
    kalimatDialog: Terimakasih yaa!
    nextDialogID: SELESAI
    punyaPilihan: 0
    pilihan1_Teks: Mi Ayam Bakso
    pilihan1_NextID: pilih_bakso
    pilihan1_EfekMoralitas: 0
    pilihan2_Teks: Mi Ayam Pangsit
    pilihan2_NextID: pilih_pangsit
    pilihan2_EfekMoralitas: 0
  - dialogID: selesai_dialog_jahat
    namaKarakter: Rasyid (Penjual)
    kalimatDialog: Sudah Kamu pergi saja!!
    nextDialogID: SELESAI
    punyaPilihan: 0
    pilihan1_Teks: Mi Ayam Bakso
    pilihan1_NextID: pilih_bakso
    pilihan1_EfekMoralitas: 0
    pilihan2_Teks: Mi Ayam Pangsit
    pilihan2_NextID: pilih_pangsit
    pilihan2_EfekMoralitas: 0
